# ---------------------------------------------------------------------------
# cars-api configuration
#
# Every variable below has a working default (see src/config/env.schema.ts), so
# an empty .env still boots against the local docker-compose stack. Copy this
# file to `.env` and override only what you need.
# ---------------------------------------------------------------------------

# Runtime ------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# HTTP server ---------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Grace period (ms) for in-flight requests during shutdown.
SHUTDOWN_TIMEOUT_MS=10000
# Comma separated origins, or * for any.
CORS_ORIGINS=*

# Logging -------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true renders human readable logs. Use in a terminal only, never in production.
LOG_PRETTY=true

# MongoDB -------------------------------------------------------------------
# Inside docker-compose use: mongodb://mongo:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cars
MONGODB_CONNECT_TIMEOUT_MS=10000

# NHTSA vPIC API ------------------------------------------------------------
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
NHTSA_TIMEOUT_MS=15000
NHTSA_MAX_RETRIES=3
NHTSA_RETRY_BASE_DELAY_MS=300
# Max concurrent upstream requests during ingestion.
NHTSA_CONCURRENCY=8

# GraphQL -------------------------------------------------------------------
GRAPHQL_PATH=/graphql
# Defaults to true outside production.
# GRAPHQL_INTROSPECTION=true

# Feature flags -------------------------------------------------------------
# Run a full ingestion pass on startup.
INGEST_ON_STARTUP=false
# Cap makes ingested (0 = no cap). Handy for a fast local run.
INGEST_MAKE_LIMIT=0
